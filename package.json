{
  "name": "@iinm/plain-agent",
  "version": "1.12.0",
  "description": "A lightweight terminal-based coding agent focused on safety and low token cost",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iinm/plain-agent.git"
  },
  "keywords": [
    "coding-agent"
  ],
  "bin": {
    "plain": "bin/plain",
    "plain-notify-desktop": "bin/plain-notify-desktop",
    "plain-sandbox": "sandbox/bin/plain-sandbox"
  },
  "files": [
    "bin",
    "sandbox/bin",
    "config",
    "src/**/*.mjs",
    "src/**/*.d.ts",
    "src/**/*.json",
    "!src/**/*.test.mjs",
    "!src/**/*.test.*.mjs",
    "!src/**/*.playground.mjs",
    "!src/**/test/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run lint && tsc && npm run test && npm run test:e2e && npm run test:predefined-approval",
    "test": "node --test 'src/**/*.test.mjs'",
    "test:e2e": "node --test --test-timeout=30000 'e2e/**/*.test.mjs'",
    "coverage": "c8 --exclude='src/**/*.test.mjs' --exclude='e2e/**' node --test --test-force-exit 'src/**/*.test.mjs' 'e2e/**/*.test.mjs'",
    "test:predefined-approval": "bash -c 'set -e; mkdir -p tmp; cd tmp; env HOME=. ../bin/plain test-approval'",
    "lint": "npx @biomejs/biome check",
    "fix": "npx @biomejs/biome check --fix",
    "version": "sed -i \"s|badge.socket.dev/npm/package/@iinm/plain-agent/[0-9][0-9.]*|badge.socket.dev/npm/package/@iinm/plain-agent/${npm_package_version}|g\" README.md && git add README.md"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^22.19.17",
    "c8": "^11.0.0",
    "typescript": "^6.0.2"
  }
}
