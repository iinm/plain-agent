{
  "name": "@iinm/plain-agent",
  "version": "1.8.3",
  "description": "A lightweight CLI-based coding agent",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iinm/plain-agent.git"
  },
  "bin": {
    "plain": "bin/plain",
    "plain-notify-desktop": "bin/plain-notify-desktop",
    "plain-sandbox": "sandbox/bin/plain-sandbox"
  },
  "files": [
    "bin",
    "sandbox/bin",
    "config",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/main.mjs --bundle --platform=node --target=node22 --outfile=dist/main.mjs --minify --sourcemap --format=esm --banner:js='import { createRequire } from \"node:module\";const require=createRequire(import.meta.url);'",
    "prepublishOnly": "npm run build",
    "check": "npm run lint && tsc && npm run test",
    "test": "node --test",
    "lint": "npx @biomejs/biome check",
    "fix": "npx @biomejs/biome check --fix"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^22.19.17",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.2"
  }
}
