{
  "autoApproval": {
    "defaultAction": "ask",
    "maxApprovals": 100,
    "patterns": [
      {
        "toolName": "exec_command",
        "input": { "command": "find" },
        "action": "deny",
        "reason": "Use fd instead; fd respects .gitignore by default"
      },
      {
        "toolName": "exec_command",
        "input": { "command": "grep" },
        "action": "deny",
        "reason": "Use rg instead; rg respects .gitignore by default"
      },

      {
        "toolName": "exec_command",
        "input": { "command": { "$regex": "^(gh|docker)$" } },
        "action": "ask"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": [
            {
              "$regex": "^(fetch|pull|clone|checkout|switch|add|commit|push|reset|rebase|merge|cherry-pick|stash|rm|mv|clean|restore|ls-remote)$"
            }
          ]
        },
        "action": "ask"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "npm",
          "args": { "$has": { "$regex": "^(i|ci|install)$" } }
        },
        "action": "ask"
      },

      {
        "toolName": { "$regex": "^(write_file|patch_file)$" },
        "action": "allow"
      },
      {
        "toolName": { "$regex": "^(web_search|web_fetch)$" },
        "action": "allow"
      },
      {
        "toolName": "compact_context",
        "action": "allow"
      },

      {
        "toolName": "exec_command",
        "action": "allow"
      }
    ],
    "tests": [
      {
        "desc": "gh should require approval",
        "toolUse": { "toolName": "exec_command", "input": { "command": "gh" } },
        "expectedAction": "ask"
      },
      {
        "desc": "docker should require approval",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "docker" }
        },
        "expectedAction": "ask"
      },
      {
        "desc": "git push should require approval",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "git", "args": ["push"] }
        },
        "expectedAction": "ask"
      }
    ]
  },
  "sandbox": {
    "command": ".plain-agent/sandbox/run.sh",
    "args": ["--keep-alive", "30"],
    "separator": "--",
    "rules": [
      {
        "pattern": { "command": { "$regex": "^(gh|docker)$" } },
        "mode": "unsandboxed"
      },
      {
        "pattern": {
          "command": "git",
          "args": [
            {
              "$regex": "^(fetch|pull|clone|checkout|switch|add|commit|push|reset|rebase|merge|cherry-pick|stash|rm|mv|clean|restore|ls-remote)$"
            }
          ]
        },
        "mode": "unsandboxed"
      },
      {
        "pattern": {
          "command": "npm",
          "args": [{ "$regex": "^(i|ci|install)$" }]
        },
        "mode": "sandbox",
        "additionalArgs": ["--allow-net", "0.0.0.0/0"]
      }
    ]
  }
}
