{
  "model": "glm-5.2+fireworks",

  "platforms": [
    {
      "name": "openai-compatible",
      "variant": "fireworks",
      "baseURL": "https://api.fireworks.ai/inference",
      "apiKey": { "$env": "FIREWORKS_API_KEY" }
    }
  ],

  "systemPrompt": {
    "userPreferences": [
      "- Keep all outputs, including responses, notes, reports, and code comments, concise, focused, and written in plain language",
      "- Limit code comments to the following purposes:",
      "  1. Specifications for public APIs/functions",
      "  2. Design decisions that cannot be understood from the code itself",
      "  3. Incomplete work: TODO/FIXME"
    ]
  },

  "tools": {
    "execCommand": {
      "secrets": {
        "GH_TOKEN": { "$env": "GH_TOKEN" }
      }
    },
    "webSearch": {
      "provider": "command",
      "command": "bash",
      "args": ["-c", "w3m -dump -o display_link_number=1 \"https://lite.duckduckgo.com/lite/?q=$*\"", "-"]
    },
    "webFetch": {
      "provider": "command",
      "command": "w3m",
      "args": ["-dump", "-o", "display_link_number=1"]
    }
  },

  "sandbox": {
    "command": "plain-sandbox",
    "args": ["--allow-write", "--mount-readonly", ".git", "--mount-readonly", ".plain-agent/config.github-actions.json", "--keep-alive", "30"],
    "separator": "--",

    "rules": [
      {
        "pattern": {
          "command": { "$regex": "^(gh|git)$" }
        },
        "mode": "unsandboxed"
      }
    ]
  },

  "autoApproval": {
    "defaultAction": "deny",
    "maxApprovals": 100,
    "patterns": [
      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": [
            { "$regex": "^(status|diff|log|show|rev-parse|switch|checkout|add|commit|reset|revert)$" }
          ]
        },
        "action": "allow"
      },

      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": { "$has": { "$regex": "^(https?|git|ssh)://|^git@" } }
        },
        "action": "deny",
        "reason": "URL arguments are not allowed; use configured remotes"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": [{ "$regex": "^(ls-remote|fetch|pull|push)$" }]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": { "command": "git" },
        "action": "deny"
      },

      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": { "$has": { "$regex": "^--hostname($|=)" } }
        },
        "action": "deny",
        "reason": "--hostname is not allowed; gh must target the default host (github.com)"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": [{ "$regex": "^(pr|issue)$" }]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": ["run", { "$regex": "^(list|view)$" }]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": { "$count": { "of": { "$regex": "(--method|^-[a-zA-Z]*X)" }, "max": 1 } }
        },
        "action": "deny",
        "reason": "--method/-X must appear at most once"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": ["api", { "$not": { "$regex": "^--(method|help)" } }]
        },
        "action": "deny",
        "reason": "--method must be specified right after 'api'"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": [
            "api",
            "--method",
            "GET",
            { "$regex": "^repos/[^/]+/[^/]+/(pulls|issues)/" }
          ]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": { "command": "gh" },
        "action": "deny"
      },

      {
        "toolName": { "$regex": "^(write_file|patch_file)$" },
        "action": "allow"
      },
      {
        "toolName": { "$regex": "^(web_search|web_fetch)$" },
        "action": "allow"
      },
      {
        "toolName": "compact_context",
        "action": "allow"
      },

      {
        "toolName": "exec_command",
        "action": "allow"
      }
    ],

    "tests": [
      {
        "desc": "git push with URL should be denied",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "git", "args": ["push", "https://github.com/iinm/unknown-repo"] }
        },
        "expectedAction": "deny"
      },
      {
        "desc": "gh with --hostname should be denied",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "gh", "args": ["pr", "list", "--hostname", "github.example.com"] }
        },
        "expectedAction": "deny"
      },
      {
        "desc": "gh api --method GET ... -X DELETE should be denied",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "gh", "args": ["api", "--method", "GET", "repos/iinm/plain-agent/issues/224", "-X", "DELETE"] }
        },
        "expectedAction": "deny"
      }
    ]
  }
}
