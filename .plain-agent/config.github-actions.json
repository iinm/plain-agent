{
  "model": "glm-5.3-flash+fireworks",

  "platforms": [
    {
      "name": "openai-compatible",
      "variant": "fireworks",
      "baseURL": "https://api.fireworks.ai/inference",
      "apiKey": { "$env": "FIREWORKS_API_KEY" }
    }
  ],

  "systemPrompt": {
    "userPreferences": [
      "- Keep all outputs, including responses, notes, reports, and code comments, concise, focused, and written in plain language",
      "- Limit code comments to the following purposes:",
      "  1. Specifications for public APIs/functions",
      "  2. Design decisions that cannot be understood from the code itself",
      "  3. Incomplete work: TODO/FIXME"
    ]
  },

  "tools": {
    "execCommand": {
      "secrets": {
        "GH_TOKEN": { "$env": "GH_TOKEN" }
      }
    },
    "webSearch": {
      "provider": "command",
      "command": "bash",
      "args": ["-c", "w3m -dump -o display_link_number=1 \"https://lite.duckduckgo.com/lite/?q=$*\"", "-"]
    },
    "webFetch": {
      "provider": "command",
      "command": "w3m",
      "args": ["-dump", "-o", "display_link_number=1"]
    }
  },

  "sandbox": {
    "command": "plain-sandbox",
    "args": [
      "--allow-write",
      "--mount-readonly", ".plain-agent",
      "--mount-writable", ".plain-agent/memory",
      "--mount-writable", ".plain-agent/tmp",
      "--env", "GH_TOKEN",
      "--keep-alive", "30"
    ],
    "separator": "--",
    "rules": [
      {
        "pattern": {
          "command": { "$regex": "^(gh|git)$" }
        },
        "mode": "sandbox",
        "additionalArgs": ["--allow-net", "github.com,api.github.com"]
      }
    ]
  },

  "autoApproval": {
    "defaultAction": "deny",
    "maxApprovals": 100,
    "patterns": [
      {
        "toolName": { "$regex": "^(write_file|patch_file)$" },
        "action": "allow"
      },
      {
        "toolName": { "$regex": "^(web_search|web_fetch)$" },
        "action": "allow"
      },
      {
        "toolName": "compact_context",
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "action": "allow"
      }
    ]
  }
}
