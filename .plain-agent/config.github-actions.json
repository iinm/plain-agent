{
  "model": "qwen3.8-max+fireworks",

  "platforms": [
    {
      "name": "openai-compatible",
      "variant": "fireworks",
      "baseURL": "https://api.fireworks.ai/inference",
      "apiKey": { "$env": "FIREWORKS_API_KEY" }
    }
  ],

  "systemPrompt": {
    "userPreferences": [
      "- Keep all outputs, including responses, notes, reports, and code comments, concise, focused, and written in plain language",
      "- Limit code comments to the following purposes:",
      "  1. Specifications for public APIs/functions",
      "  2. Design decisions that cannot be understood from the code itself",
      "  3. Incomplete work: TODO/FIXME"
    ]
  },

  "tools": {
    "execCommand": {
      "secrets": {
        "GH_TOKEN": { "$env": "GH_TOKEN" }
      }
    },
    "webSearch": {
      "provider": "command",
      "command": "bash",
      "args": ["-c", "w3m -dump -o display_link_number=1 \"https://lite.duckduckgo.com/lite/?q=$*\"", "-"]
    },
    "webFetch": {
      "provider": "command",
      "command": "w3m",
      "args": ["-dump", "-o", "display_link_number=1"]
    }
  },

  "sandbox": {
    "command": "plain-sandbox",
    "args": ["--allow-write", "--mount-readonly", ".git", "--mount-readonly", ".plain-agent/config.github-actions.json", "--keep-alive", "30"],
    "separator": "--",

    "rules": [
      {
        "pattern": {
          "command": { "$regex": "^(gh|git)$" }
        },
        "mode": "unsandboxed"
      }
    ]
  },

  "autoApproval": {
    "defaultAction": "deny",
    "maxApprovals": 100,
    "patterns": [
      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": [
            { "$regex": "^(status|diff|log|show|ls-remote|rev-parse|switch|checkout|add|commit|reset|revert)$" }
          ]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": ["push", "https://github.com/iinm/plain-agent"]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": ["push", { "$not": "https://github.com/iinm/plain-agent" }]
        },
        "action": "deny",
        "reason": "Use push https://github.com/iinm/plain-agent ..."
      },
      {
        "toolName": "exec_command",
        "input": { "command": "git" },
        "action": "deny"
      },

      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": [{ "$regex": "^(pr|issue)$" }]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": ["run", { "$regex": "^(list|view)$" }]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": [
            "api",
            "--method",
            "GET",
            { "$regex": "^repos/[^/]+/[^/]+/(pulls|issues)/" }
          ]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "gh",
          "args": ["api", { "$not": { "$regex": "^--(method|help)" } }]
        },
        "action": "deny",
        "reason": "--method must be specified right after 'api'"
      },
      {
        "toolName": "exec_command",
        "input": { "command": "gh" },
        "action": "deny"
      },

      {
        "toolName": { "$regex": "^(write_file|patch_file)$" },
        "action": "allow"
      },
      {
        "toolName": { "$regex": "^(web_search|web_fetch)$" },
        "action": "allow"
      },
      {
        "toolName": "compact_context",
        "action": "allow"
      },

      {
        "toolName": "exec_command",
        "action": "allow"
      }
    ],

    "tests": [
      {
        "desc": "git push unknown origin should be denied",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "git", "args": ["push", "https://github.com/iinm/unknown-repo"] }
        },
        "expectedAction": "deny"
      },
      {
        "desc": "git push with https://... should be allowed",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "git", "args": ["push", "https://github.com/iinm/plain-agent"] }
        },
        "expectedAction": "allow"
      }
    ]
  }
}
