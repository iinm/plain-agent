{
  "model": "deepseek-v4.1-flash+fireworks",

  "platforms": [
    {
      "name": "openai-compatible",
      "variant": "fireworks",
      "baseURL": "https://api.fireworks.ai/inference",
      "apiKey": { "$env": "FIREWORKS_API_KEY" }
    }
  ],

  "systemPrompt": {
    "userPreferences": [
      "Concise, plain language with concrete examples",
      "",
      "Rules:",
      "- Code comments are prohibited by default. Exceptions:",
      "  1. Public API / function specifications",
      "  2. Design decisions not apparent from the code"
    ]
  },

  "tools": {
    "execCommand": {
      "secrets": {
        "GH_TOKEN": { "$env": "GH_TOKEN" }
      }
    },
    "webSearch": {
      "provider": "command",
      "command": "bash",
      "args": ["-c", "w3m -dump -o display_link_number=1 \"https://lite.duckduckgo.com/lite/?q=$*\"", "-"]
    },
    "webFetch": {
      "provider": "command",
      "command": "w3m",
      "args": ["-dump", "-o", "display_link_number=1"],
      "allowedDomains": [
        "github.com",
        "docs.github.com",
        "nodejs.org",
        "fireworks.ai",
        "developers.openai.com",
        "platform.claude.com",
        "ai.google.dev",
        "docs.aws.amazon.com",
        "docs.cloud.google.com",
        "developer.mozilla.org",
        "stackoverflow.com"
      ]
    }
  },

  "sandbox": {
    "command": "plain-sandbox",
    "args": [
      "--allow-write",
      "--mount-readonly", ".plain-agent",
      "--mount-writable", ".plain-agent/memory",
      "--mount-writable", ".plain-agent/tmp",
      "--keep-alive", "30"
    ],
    "separator": "--",
    "rules": [
      {
        "pattern": {
          "command": { "$regex": "^(gh|git)$" }
        },
        "mode": "sandbox",
        "additionalArgs": ["--env", "GH_TOKEN", "--allow-net", "github.com,api.github.com"]
      
      }
    ]
  },

  "autoApproval": {
    "defaultAction": "deny",
    "maxApprovals": 100,
    "patterns": [
      {
        "toolName": { "$regex": "^(write_file|patch_file)$" },
        "action": "allow"
      },
      {
        "toolName": { "$regex": "^(web_search|web_fetch)$" },
        "action": "allow"
      },
      {
        "toolName": "compact_context",
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": { "command": "find" },
        "action": "deny",
        "reason": "Use fd instead; fd respects .gitignore by default"
      },
      {
        "toolName": "exec_command",
        "input": { "command": "grep" },
        "action": "deny",
        "reason": "Use rg instead; rg respects .gitignore by default"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "bash",
          "args": ["-c", { "$not": { "$regex": "[|><&;$`]" } }]
        },
        "action": "deny",
        "reason": "Use bash -c only when shell features (|, >, <, &, ;, $, `) are required"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "bash",
          "args": { "$has": { "$regex": "^(--login|-[^-]*l)" } }
        },
        "action": "deny",
        "reason": "Login shell options (-l, --login) are not necessary"
      },
      {
        "toolName": "exec_command",
        "action": "allow"
      }
    ]
  }
}
