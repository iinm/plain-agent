{
  "autoApproval": {
    "defaultAction": "ask",
    "maxApprovals": 100,
    "patterns": [
      {
        "toolName": "exec_command",
        "input": { "command": { "$regex": "^(gh|docker)$" } },
        "action": "ask"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": { "$has": { "$regex": "^(commit|fetch|pull|push)$" } }
        },
        "action": "ask"
      },

      {
        "toolName": { "$regex": "^(write_file|patch_file)$" },
        "action": "allow"
      },
      {
        "toolName": { "$regex": "^(web_search|web_fetch)$" },
        "action": "allow"
      },
      { "toolName": "exec_command", "action": "allow" }
    ],
    "tests": [
      {
        "desc": "gh should require approval",
        "toolUse": { "toolName": "exec_command", "input": { "command": "gh" } },
        "expectedAction": "ask"
      },
      {
        "desc": "docker should require approval",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "docker" }
        },
        "expectedAction": "ask"
      },
      {
        "desc": "git commit should require approval",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "git", "args": ["-C", "/anywhere", "commit"] }
        },
        "expectedAction": "ask"
      },
      {
        "desc": "git push should require approval",
        "toolUse": {
          "toolName": "exec_command",
          "input": { "command": "git", "args": ["-C", "/anywhere", "push"] }
        },
        "expectedAction": "ask"
      }
    ]
  },
  "sandbox": {
    "command": ".plain-agent/sandbox/run.sh",
    "args": ["--keep-alive", "30"],
    "separator": "--",
    "rules": [
      {
        "pattern": { "command": { "$regex": "^(gh|docker)$" } },
        "mode": "unsandboxed"
      },
      {
        "pattern": {
          "command": "git",
          "args": [{ "$regex": "^(fetch|pull|push)$" }]
        },
        "mode": "unsandboxed"
      },
      {
        "pattern": { "command": "npm", "args": ["ci"] },
        "mode": "sandbox",
        "additionalArgs": ["--allow-net", "0.0.0.0/0"]
      }
    ]
  },
  "claudeCodePlugins": [
    {
      "source": "https://github.com/anthropics/claude-code",
      "plugins": [
        { "name": "feature-dev", "path": "plugins/feature-dev" },
        { "name": "code-review", "path": "plugins/code-review" },
        { "name": "pr-review-toolkit", "path": "plugins/pr-review-toolkit" }
      ]
    }
  ]
}
